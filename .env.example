# Spectrum Cloud credentials from app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# OpenRouter API key (openrouter.ai) — powers memory extraction (and later,
# adaptive prompt generation)
OPENROUTER_API_KEY=

# Self-hosted Supermemory (see README for install steps). The API key is
# printed to the server's log on first boot.
SUPERMEMORY_API_KEY=
# Only needed if not running on the default localhost:6767
# SUPERMEMORY_BASE_URL=http://localhost:6767
